<?xml version="1.0" encoding="utf-8"?>
<!-- Photos of faces stay on the phone: nothing goes to cloud backup. Device-to-device transfer keeps settings only. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" />
        <exclude domain="database" />
    </device-transfer>
</data-extraction-rules>
